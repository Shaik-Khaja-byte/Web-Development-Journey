<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Chat</title>
</head>
<body>
    <form method="POST", action="/chats">
        <h2>Write a new chat!</h2>
        <input type="text" name="from" placeholder="who are you?">
        <br><br>
        <textarea name="msg" placeholder="what's the message?"></textarea>
        <br><br>
        <input type="text" name="to" placeholder="who are you sending to?">
        <br><br>
        <button>Add Chat</button>
    </form>
</body>
</html>