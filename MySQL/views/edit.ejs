<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Username</title>
</head>
<body>
    <h1>Hello <%=user.email%>, You are about to edit your username.</h1>
    <br>
    <form method="post" action="/user/<%=user.id%>?_method=PATCH">
        <textarea name="username"><%=user.username%></textarea>
        <br>
        <br>
        <input type="password" name="password" placeholder="confirm your password">
        <br>
        <br>
        <button>Save</button>
    </form>
</body>
</html>